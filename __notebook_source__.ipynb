# Simulating 1200 structured skin lesion images [Batch, Channels, Height, Width]
np.random.seed(42)
torch.manual_seed(42)

X_raw = np.random.randn(1200, 3, 64, 64).astype(np.float32)
y_raw = np.random.choice([0, 1], size=1200, p=[0.6, 0.4]).astype(np.int64) # 0: Benign, 1: Malignant

print(f"Total Dataset Shape: {X_raw.shape}")
print(f"Class Balance -> Benign (Class 0): {np.sum(y_raw==0)} | Malignant (Class 1): {np.sum(y_raw==1)}")

# Splitting Data with Exact Ratio: 70% Train, 20% Test, 10% Validation
# 1. Take 70% for training first
X_train, X_temp, y_train, y_temp = train_test_split(X_raw, y_raw, test_size=0.30, random_state=42, stratify=y_raw)
# 2. From remaining 30%, split into 20% Test and 10% Validation (2/3 and 1/3)
X_test, X_val, y_test, y_val = train_test_split(X_temp, y_temp, test_size=(10/30), random_state=42, stratify=y_temp)

print(f"\n--- Data Split Statistics ---")
print(f"Training Set (70%):   {X_train.shape[0]} samples")
print(f"Testing Set (20%):    {X_test.shape[0]} samples")
print(f"Validation Set (10%): {X_val.shape[0]} samples")

# PyTorch Data Loaders
train_loader = DataLoader(TensorDataset(torch.tensor(X_train), torch.tensor(y_train)), batch_size=32, shuffle=True)
val_loader = DataLoader(TensorDataset(torch.tensor(X_val), torch.tensor(y_val)), batch_size=32, shuffle=False)
test_loader = DataLoader(TensorDataset(torch.tensor(X_test), torch.tensor(y_test)), batch_size=32, shuffle=False)



import torch
import torch.nn as nn
import torch.optim as optim

# 1. Model Structure Define Karein
class SkinCancerCNN(nn.Module):
    def __init__(self):
        super().__init__()
        self.features = nn.Sequential(
            nn.Conv2d(3, 16, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2, 2), # Out: 16 x 32 x 32
            nn.Conv2d(16, 32, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2, 2)  # Out: 32 x 16 x 16
        )
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(32 * 16 * 16, 64),
            nn.ReLU(),
            nn.Dropout(0.3),
            nn.Linear(64, 2) 
        )
    def forward(self, x):
        return self.classifier(self.features(x))

# 2. Model, Loss Function aur Optimizer Initialization
model = SkinCancerCNN()
criterion = nn.CrossEntropyLoss()
optimizer = optim.Adam(model.parameters(), lr=0.001)

print("Model successfully initialize ho gaya hai!")


train_losses, val_losses, test_losses = [], [], []
epochs = 20

for epoch in range(epochs):
    model.train()
    running_train_loss = 0.0
    for images, labels in train_loader:
        optimizer.zero_grad()
        logits = model(images).squeeze()
        loss = criterion(logits, labels)
        loss.backward()
        optimizer.step()
        running_train_loss += loss.item() * images.size(0)
        
    # Evaluation tracking across folds
    model.eval()
    running_val_loss, running_test_loss = 0.0, 0.0
    with torch.no_grad():
        for images, labels in val_loader:
            running_val_loss += criterion(model(images).squeeze(), labels).item() * images.size(0)
        for images, labels in test_loader:
            running_test_loss += criterion(model(images).squeeze(), labels).item() * images.size(0)
            
    train_losses.append(running_train_loss / len(train_loader.dataset))
    val_losses.append(running_val_loss / len(val_loader.dataset))
    test_losses.append(running_test_loss / len(test_loader.dataset))

print("\n=== MODEL OPTIMIZATION AND TRAINING COMPLETE ===")


import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split
from sklearn.metrics import classification_report, confusion_matrix
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader, TensorDataset

print("Step 1: All libraries successfully imported!")



print("=== STARTING EXPLORATORY DATA ANALYSIS (EDA) ===")

# 1200 structured skin lesion images simulate kar rahe hain [Batch, Channels, Height, Width]
np.random.seed(42)
torch.manual_seed(42)

X_raw = np.random.randn(1200, 3, 64, 64).astype(np.float32)
y_raw = np.random.choice([0, 1], size=1200, p=[0.6, 0.4]).astype(np.int64) # 0: Benign, 1: Malignant

print(f"Total Dataset Shape: {X_raw.shape}")
print(f"Class Balance -> Benign (Class 0): {np.sum(y_raw==0)} | Malignant (Class 1): {np.sum(y_raw==1)}")

# Exact Split (70% Train, 20% Test, 10% Validation) Implementation
X_train, X_temp, y_train, y_temp = train_test_split(X_raw, y_raw, test_size=0.30, random_state=42, stratify=y_raw)
X_test, X_val, y_test, y_val = train_test_split(X_temp, y_temp, test_size=(10/30), random_state=42, stratify=y_temp)

print(f"\n--- Data Split Statistics ---")
print(f"Training Set (70%):   {X_train.shape} samples")
print(f"Testing Set (20%):    {X_test.shape} samples")
print(f"Validation Set (10%): {X_val.shape} samples")

# PyTorch Data Loaders Setup
train_loader = DataLoader(TensorDataset(torch.tensor(X_train), torch.tensor(y_train)), batch_size=32, shuffle=True)
val_loader = DataLoader(TensorDataset(torch.tensor(X_val), torch.tensor(y_val)), batch_size=32, shuffle=False)
test_loader = DataLoader(TensorDataset(torch.tensor(X_test), torch.tensor(y_test)), batch_size=32, shuffle=False)



# =====================================================================
# STEP 3: CNN MODEL ARCHITECTURE
# =====================================================================
class SkinCancerCNN(nn.Module):
    def __init__(self):
        super().__init__()
        # Convolutional Layers: Images se features extract karne ke liye
        self.features = nn.Sequential(
            nn.Conv2d(3, 16, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2, 2), # Size output: 16 x 32 x 32
            nn.Conv2d(16, 32, kernel_size=3, padding=1),
            nn.ReLU(),
            nn.MaxPool2d(2, 2)  # Size output: 32 x 16 x 16
        )
        # Fully Connected Layers: Final classification ke liye
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(32 * 16 * 16, 64),
            nn.ReLU(),
            nn.Dropout(0.3),    # Overfitting se bachne ke liye
            nn.Linear(64, 2)    # 2 Classes: Benign (0) aur Malignant (1)
        )
    def forward(self, x):
        return self.classifier(self.features(x))

# Model ko initialize karna
model = SkinCancerCNN()

# Loss function aur Optimizer setup karna
criterion = nn.CrossEntropyLoss()
optimizer = optim.Adam(model.parameters(), lr=0.001)

print("Step 3: CNN Model initialized successfully!")



# =====================================================================
# STEP 4: MODEL TRAINING & TRACKING
# =====================================================================
train_losses, val_losses, test_losses = [], [], []
train_accs, val_accs = [], []
epochs = 15

print("=== STARTING TRAINING PROCESS ===")
for epoch in range(epochs):
    model.train()
    running_loss, correct_t, total_t = 0.0, 0, 0
    for inputs, targets in train_loader:
        optimizer.zero_grad()
        outputs = model(inputs)
        loss = criterion(outputs, targets)
        loss.backward()
        optimizer.step()
        
        running_loss += loss.item() * inputs.size(0)
        _, preds = torch.max(outputs, 1)
        correct_t += (preds == targets).sum().item()
        total_t += targets.size(0)
        
    # Validation / Testing assessment
    model.eval()
    val_loss, correct_v, total_v = 0.0, 0, 0
    test_loss = 0.0
    with torch.no_grad():
        for inputs, targets in val_loader:
            outputs = model(inputs)
            loss = criterion(outputs, targets)
            val_loss += loss.item() * inputs.size(0)
            _, preds = torch.max(outputs, 1)
            correct_v += (preds == targets).sum().item()
            total_v += targets.size(0)
            
        for inputs, targets in test_loader:
            outputs = model(inputs)
            test_loss += criterion(outputs, targets).item() * inputs.size(0)

    # Tracking arrays append
    train_losses.append(running_loss / total_t)
    val_losses.append(val_loss / total_v)
    test_losses.append(test_loss / len(X_test))
    train_accs.append(correct_t / total_t)
    val_accs.append(correct_v / total_v)
    
    print(f"Epoch {epoch+1:02d}/{epochs} -> Train Loss: {train_losses[-1]:.4f} | Train Acc: {train_accs[-1]*100:.2f}% | Val Accuracy: {val_accs[-1]*100:.2f}%")

print("\n=== MODEL OPTIMIZATION AND TRAINING COMPLETE ===")



# =====================================================================
# STEP 5: CLASSIFICATION REPORT & CONFUSION MATRIX
# =====================================================================
model.eval()
test_preds, test_targets = [], []

with torch.no_grad():
    for inputs, targets in test_loader:
        outputs = model(inputs)
        _, preds = torch.max(outputs, 1)
        
        # Array vectors ko completely linear aur flat 1D structures me force kar rahe hain
        test_preds.extend(preds.view(-1).cpu().numpy())
        test_targets.extend(targets.view(-1).cpu().numpy())

y_true_stable = np.array(test_targets, dtype=int)
y_pred_stable = np.array(test_preds, dtype=int)

print("\n--- TEST SET CLASSIFICATION REPORT ---")
print(classification_report(y_true_stable, y_pred_stable, target_names=['Benign (0)', 'Malignant (1)']))

print("--- CONFUSION MATRIX ---")
cm = confusion_matrix(y_true_stable, y_pred_stable)
print(cm)



# =====================================================================
# STEP 6: VISUALIZE LOSS & ACCURACY CURVES
# =====================================================================
epochs_range = range(1, len(train_losses) + 1)
plt.figure(figsize=(14, 5))

# 1. Training, Testing, Validation Loss Graph
plt.subplot(1, 2, 1)
plt.plot(epochs_range, train_losses, label='Training Loss', color='blue', marker='o')
plt.plot(epochs_range, val_losses, label='Validation Loss', color='orange', marker='s')
plt.plot(epochs_range, [float(l) for l in test_losses], label='Testing Loss', color='green', marker='x')
plt.title('Training, Validation & Testing Loss Curves')
plt.xlabel('Epochs')
plt.ylabel('Loss Value')
plt.legend()
plt.grid(True)

# 2. Training vs Validation Accuracy Graph
plt.subplot(1, 2, 2)
plt.plot(epochs_range, train_accs, label='Training Accuracy', color='blue', marker='o')
plt.plot(epochs_range, val_accs, label='Validation Accuracy', color='orange', marker='s')
plt.title('Training vs Validation Accuracy Curves')
plt.xlabel('Epochs')
plt.ylabel('Accuracy Score')
plt.legend()
plt.grid(True)

plt.tight_layout()
plt.show()



# =====================================================================
# STEP 7: LIVE PREDICTIONS FOR 10 TEST IMAGES
# =====================================================================
print("\n=== GENERATING PREDICTIONS FOR 10 TARGET TEST IMAGES ===")

# Test set se pehli 10 images aur unke asli labels nikal rahe hain
sample_images = torch.tensor(X_test[:10])
sample_actuals = y_test[:10]

# Model ko evaluation mode par set karke predict karwana
model.eval()
with torch.no_grad():
    sample_outputs = model(sample_images)
    probabilities = torch.softmax(sample_outputs, dim=1)
    _, sample_preds = torch.max(sample_outputs, 1)

# Result ko formatting ke sath display karna
print("-" * 85)
print(f"{'Image #':<9} | {'Actual Data Label':<18} | {'Predicted Data Label':<18} | {'Confidence Score':<15}")
print("-" * 85)

for idx in range(10):
    actual_label = "Malignant (1)" if sample_actuals[idx] == 1 else "Benign (0)"
    pred_label = "Malignant (1)" if sample_preds[idx] == 1 else "Benign (0)"
    confidence = probabilities[idx][sample_preds[idx]].item() * 100
    
    print(f"Image #{idx+1:02d}  | {actual_label:<18} | {pred_label:<18} | {confidence:.2f}%")

print("-" * 85)
print("=== ALL STEPS FULLY COMPLETED WITH SUCCESS! ===")



# Model ko Kaggle output directory me save karne ke liye
torch.save(model.state_dict(), 'skin_cancer_cnn_model.pth')
print("Model successfully save ho gaya hai! Aap ise Kaggle Output folder se download kar sakte hain.")

